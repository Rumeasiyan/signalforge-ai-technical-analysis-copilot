generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InstrumentType {
  STOCK
  INDEX
  ETF
  FOREX
  CRYPTO
  COMMODITY
}

enum AnalysisTimeframe {
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
}

enum DirectionalBias {
  BULLISH
  BEARISH
  NEUTRAL
}

model User {
  id            Int             @id @default(autoincrement())
  email         String          @unique
  clerkId       String          @unique
  name          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  watchlist     WatchlistItem[]
  analyses      Analysis[]
}

model Instrument {
  id             Int             @id @default(autoincrement())
  symbol         String          @unique
  name           String
  type           InstrumentType
  exchange       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  watchlistItems WatchlistItem[]
  analyses       Analysis[]
}

model WatchlistItem {
  id           Int        @id @default(autoincrement())
  userId       Int
  instrumentId Int
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([userId, instrumentId])
  @@index([userId])
}

model Analysis {
  id                  Int               @id @default(autoincrement())
  userId              Int
  instrumentId        Int
  timeframe           AnalysisTimeframe
  directionalBias     DirectionalBias
  setupQualityScore   Int
  confidenceScore     Int
  momentumCondition   String
  trendSummary        String
  plainLanguageView   String
  keySupportZones     Json
  keyResistanceZones  Json
  indicatorInsights   Json
  multiTimeframeView  Json
  scenarioPlan        Json
  breakoutRisk        String
  reversalRisk        String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument          Instrument        @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([instrumentId, createdAt(sort: Desc)])
}
